<% layout('/layouts/boilerplate') -%>

    <div class="row mt-3">
        <h1 class="col-6 offset-3">Sign Up On Wanderlust</h1>
        <div class="col-6 offset-3">
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input class="form-control" name="username" placeholder="Enter username" type="text" required/>
                    <div class="invalid-feedback">Please enter a username</div>
                    <div class="valid-feedback">Username looks good</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input class="form-control" name="email" placeholder="Enter email" type="email" required/>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input class="form-control" name="password" placeholder="Enter password" type="password" required/>
                </div>

                <button class="btn btn-success mt-3">Sign Up</button>
            </form>
        </div>
    </div>